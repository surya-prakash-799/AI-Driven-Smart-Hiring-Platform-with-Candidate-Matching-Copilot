# PostgreSQL connection string (defaults shown; replace with your credentials).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/recruitment_db

# Uploaded resume files
UPLOAD_DIR=app/uploads

# Extracted JSON data
EXTRACTED_DIR=app/extracted_data

# Max upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# Allowed file extensions (PDF and DOCX only)
ALLOWED_EXTENSIONS=["pdf","docx"]

# Allowed CORS origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Secret key used to sign session tokens (change in production!)
SECRET_KEY=change-this-in-production

# Session token validity in hours
TOKEN_TTL_HOURS=24

# Google Gemini API key for the AI interview features (kept on the backend only)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-1.5-flash
# Optional: AI request timeout in seconds
# AI_TIMEOUT_SECONDS=60

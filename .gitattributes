# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py text
*.js text
*.ts text
*.jsx text
*.tsx text
*.css text
*.html text
*.json text
*.md text
*.yml text
*.yaml text
*.env text
*.env.example text
*.gitignore text
*.gitattributes text

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.svg text

# PostgreSQL connection string (defaults shown; replace with your credentials).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# On Render: Use the Internal Database URL from your Render PostgreSQL service.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/recruitment_db

# Uploaded resume files
UPLOAD_DIR=app/uploads

# Extracted JSON data
EXTRACTED_DIR=app/extracted_data

# Max upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# Allowed file extensions (PDF and DOCX only)
ALLOWED_EXTENSIONS=["pdf","docx"]

# Allowed CORS origins (comma-separated or JSON array)
# For production, set this to your Vercel frontend URL, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: "development" enables hot-reload, "production" disables it
ENVIRONMENT=development

# Google Gemini API key for the AI interview features (kept on the backend only)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default Gemini model
# GEMINI_MODEL=gemini-1.5-flash
# Optional: AI request timeout in seconds
# AI_TIMEOUT_SECONDS=60

# Groq API key for Voice Screening Speech-to-Text (kept on the backend only)
GROQ_API_KEY=your_groq_api_key_here
# Whisper model used for transcription. Free tier default is whisper-large-v3-turbo
# (alternative: whisper-large-v3). Note: Groq free tier has usage/rate limits.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
